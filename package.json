{
  "name": "ai-eco-meter",
  "displayName": "AI Eco Meter",
  "description": "See, in a fun and mindful way, how much energy, water and CO₂ your AI usage consumes (Claude Code, Codex, Gemini CLI, Antigravity and more), with tokens, averages and pixel-art pets. Português e English.",
  "version": "0.8.1",
  "publisher": "pmxtecnologia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcj19/ai-eco-meter.git"
  },
  "bugs": {
    "url": "https://github.com/marcj19/ai-eco-meter/issues"
  },
  "homepage": "https://github.com/marcj19/ai-eco-meter#readme",
  "sponsor": {
    "url": "https://www.paypal.com/donate/?business=paulomjunior7%40gmail.com"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1f3b2c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai",
    "sustentabilidade",
    "energia",
    "tokens",
    "claude",
    "gemini",
    "codex",
    "antigravity",
    "pets",
    "sustainability",
    "energy",
    "carbon"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiEcoMeter",
          "title": "%container.title%",
          "icon": "media/activity-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "aiEcoMeterYard",
          "title": "%panel.yard%",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "aiEcoMeter": [
        {
          "type": "webview",
          "id": "aiEcoMeter.dashboard",
          "name": "%view.dashboard%"
        }
      ],
      "aiEcoMeterYard": [
        {
          "type": "webview",
          "id": "aiEcoMeter.yardPanel",
          "name": "%view.yard%"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "aiEcoMeter.yardExplorer",
          "name": "%view.yard%"
        }
      ]
    },
    "commands": [
      {
        "command": "aiEcoMeter.openPanel",
        "title": "%cmd.openPanel%",
        "category": "AI Eco Meter",
        "icon": "$(link-external)"
      },
      {
        "command": "aiEcoMeter.refresh",
        "title": "%cmd.refresh%",
        "category": "AI Eco Meter",
        "icon": "$(refresh)"
      },
      {
        "command": "aiEcoMeter.logManual",
        "title": "%cmd.logManual%",
        "category": "AI Eco Meter",
        "icon": "$(add)"
      },
      {
        "command": "aiEcoMeter.clearManual",
        "title": "%cmd.clearManual%",
        "category": "AI Eco Meter"
      },
      {
        "command": "aiEcoMeter.openSettings",
        "title": "%cmd.openSettings%",
        "category": "AI Eco Meter"
      },
      {
        "command": "aiEcoMeter.togglePets",
        "title": "%cmd.togglePets%",
        "category": "AI Eco Meter"
      },
      {
        "command": "aiEcoMeter.showChangelog",
        "title": "%cmd.showChangelog%",
        "category": "AI Eco Meter"
      },
      {
        "command": "aiEcoMeter.support",
        "title": "%cmd.support%",
        "category": "AI Eco Meter"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiEcoMeter.logManual",
          "when": "view == aiEcoMeter.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "aiEcoMeter.refresh",
          "when": "view == aiEcoMeter.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "aiEcoMeter.openPanel",
          "when": "view == aiEcoMeter.dashboard",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "AI Eco Meter",
      "properties": {
        "aiEcoMeter.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "pt-BR",
            "en"
          ],
          "enumDescriptions": [
            "%cfg.language.auto%",
            "%cfg.language.pt%",
            "%cfg.language.en%"
          ],
          "markdownDescription": "%cfg.language%"
        },
        "aiEcoMeter.dailyEnergyBudgetWh": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "markdownDescription": "%cfg.dailyEnergyBudgetWh%"
        },
        "aiEcoMeter.sources.claudeCode": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.sources.claudeCode%"
        },
        "aiEcoMeter.sources.codex": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.sources.codex%"
        },
        "aiEcoMeter.sources.geminiCli": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.sources.geminiCli%"
        },
        "aiEcoMeter.sources.antigravity": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.sources.antigravity%"
        },
        "aiEcoMeter.paths.claudeCode": {
          "type": "string",
          "default": "",
          "description": "%cfg.paths.claudeCode%"
        },
        "aiEcoMeter.paths.codex": {
          "type": "string",
          "default": "",
          "description": "%cfg.paths.codex%"
        },
        "aiEcoMeter.coefficients.whPer1kOutputTokens": {
          "type": "number",
          "default": 1,
          "markdownDescription": "%cfg.coefficients.whPer1kOutputTokens%"
        },
        "aiEcoMeter.coefficients.whPer1kInputTokens": {
          "type": "number",
          "default": 0.1,
          "markdownDescription": "%cfg.coefficients.whPer1kInputTokens%"
        },
        "aiEcoMeter.coefficients.whPer1kCacheWriteTokens": {
          "type": "number",
          "default": 0.12,
          "markdownDescription": "%cfg.coefficients.whPer1kCacheWriteTokens%"
        },
        "aiEcoMeter.coefficients.whPer1kCacheReadTokens": {
          "type": "number",
          "default": 0.01,
          "markdownDescription": "%cfg.coefficients.whPer1kCacheReadTokens%"
        },
        "aiEcoMeter.waterLitersPerKWh": {
          "type": "number",
          "default": 1.8,
          "markdownDescription": "%cfg.waterLitersPerKWh%"
        },
        "aiEcoMeter.gridCo2GramsPerKWh": {
          "type": "number",
          "default": 400,
          "markdownDescription": "%cfg.gridCo2GramsPerKWh%"
        },
        "aiEcoMeter.modelMultipliers": {
          "type": "object",
          "default": {
            "haiku": 0.35,
            "nano": 0.2,
            "mini": 0.35,
            "flash": 0.35,
            "sonnet": 1,
            "opus": 2,
            "fable": 3
          },
          "additionalProperties": {
            "type": "number"
          },
          "markdownDescription": "%cfg.modelMultipliers%"
        },
        "aiEcoMeter.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "%cfg.refreshIntervalSeconds%"
        },
        "aiEcoMeter.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showStatusBar%"
        },
        "aiEcoMeter.pets.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.pets.enabled%"
        },
        "aiEcoMeter.pets.list": {
          "type": "array",
          "default": [
            "gato",
            "capivara",
            "pato"
          ],
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "gato",
              "cachorro",
              "pato",
              "capivara",
              "tartaruga",
              "caranguejo"
            ]
          },
          "markdownDescription": "%cfg.pets.list%"
        },
        "aiEcoMeter.pets.inEditor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.pets.inEditor%"
        },
        "aiEcoMeter.paths.gemini": {
          "type": "string",
          "default": "",
          "description": "%cfg.paths.gemini%"
        },
        "aiEcoMeter.paths.antigravity": {
          "type": "string",
          "default": "",
          "description": "%cfg.paths.antigravity%"
        },
        "aiEcoMeter.game.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.game.enabled%"
        }
      }
    }
  }
}